  "support": {
    "help_center": "Help Center",
    "greeting": "Hi 👋\nHow can we help?",
    "search_hint": "Search questions...",
    "faq_title": "FAQ",
    "no_results": "No questions found for \"{}\"",
    "contact_us": "Contact Us",
    "contact_subtitle": "Our team is ready to help you.",
    "chat_support": "Chat Support",
    "chat_subtitle": "We're here to help.",
    "start_chat": "Start Chat",
    "email_us": "Email Us",
    "email_subtitle": "Send an email anytime.",
    "call_us": "Call Us",
    "call_subtitle": "Mon-Fri, 9am–5pm.",
    "follow_us": "FOLLOW US",
    "faq_1_q": "How do I post a task?",
    "faq_1_a": "Tap the \"+\" button below, fill in the task details like category, location, and price offer. Then submit and wait for a runner to pick up your task.",
    "faq_2_q": "How do I become a Runner?",
    "faq_2_a": "Switch your role to \"Runner\" from your profile. You can then find available tasks in the feed and accept suitable ones.",
    "faq_3_q": "How does payment work?",
    "faq_3_a": "Payment is made directly between the Customer and Runner after task completion. We recommend using DuitNow or bank transfer.",
    "faq_4_q": "Can I cancel a task?",
    "faq_4_a": "Yes, you can cancel from the \"My Tasks\" page as long as no runner has accepted it yet.",
    "faq_5_q": "What if the runner doesn't show up?",
    "faq_5_a": "Contact us through \"Contact Us\" and we will help resolve the issue within 24 hours.",
    "faq_6_q": "Can Ngam runners be trusted?",
    "faq_6_a": "All our runners must go through a strict identity verification process before their accounts are activated for your safety.",
    "faq_7_q": "Can I communicate with the runner?",
    "faq_7_a": "Yes, you can use the in-app chat to communicate with the runner once they accept your task.",
    "faq_8_q": "What if the item price changes?",
    "faq_8_a": "You can discuss with the runner through chat. The runner will inform you of the actual price with a receipt for verification.",
    "faq_9_q": "How do I give a rating?",
    "faq_9_a": "After the task is marked as complete, a pop-up will appear allowing you to rate and review the runner.",
    "faq_10_q": "Is my location information safe?",
    "faq_10_a": "Yes, your personal and exact location information will only be shared with the runner who has accepted your task.",
    "faq_11_q": "How long does it take to complete a task?",
    "faq_11_a": "It depends on the type of task and distance. You can view the estimated time or ask the runner directly.",
    "faq_12_q": "What if my item is damaged?",
    "faq_12_a": "Please take a photo of the damage and contact our customer support within 24 hours for compensation assistance.",
    "faq_13_q": "Can I tip the runner?",
    "faq_13_a": "Of course! You can give a cash tip directly to the runner or include the tip amount in your original task price offer.",
    "faq_14_q": "Is there a weight limit for items?",
    "faq_14_a": "We recommend a maximum weight of 15kg for motorcycle delivery tasks. For larger items, please state clearly in the description.",
    "faq_15_q": "Can I change location after runner accepts?",
    "faq_15_a": "Location changes after task acceptance are subject to runner agreement. Additional costs may apply."
  },
